---
import Menuhistoria from "../components/Menuhistoria.astro";
import Rojo from "../layouts/Rojo.astro";
---

<Rojo>
    <div class="menu_top">
        <a href="./">¿Qué es?</a>
        <a class="activo" href="./historia">Historia</a>
        <a href="./misionyvision">Misión y Visión</a>
        <a href="./familia">Familia Salesina</a>
        <a href="./perfil">Perfil de atendidos</a>
    </div>

    <div class="historia">
        <Menuhistoria />
    </div>

    <style>
        .historia {
            padding-right: 0.65cqw;
            padding-left: 0.75cqw;
            padding-top: 0.75cqw;
            grid-column: 11/43;
            grid-row: 5/24;
            z-index: 2;
        }

        .menu_top {
            grid-column: 13/42;
            grid-row: 3/6;
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            align-items: center;
        }

        .menu_top a {
            font-size: 1.143cqw;
            font-weight: 500;
            font-family: "Open Sans", sans-serif;
            color: #333333;
            text-decoration: none;
            transition: transform 0.25s ease;
            padding: 0.5cqw 1.1cqw;
            justify-self: center;
            text-align: center;
            white-space: nowrap;
        }

        .menu_top a:hover {
            transform: scale(1.08);
        }

        .menu_top .activo {
            font-weight: 700;
            background-color: #ff3545;
            color: #ffffff;
            border-radius: 1.4cqw;
            padding: 0.5cqw 1.1cqw;
        }
    </style>
</Rojo>
