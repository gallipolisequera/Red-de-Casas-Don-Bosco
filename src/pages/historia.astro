---
import Menuhistoria from "../components/Menuhistoria.astro";
import Rojo from "../layouts/Rojo.astro";
---

<Rojo>
    <div class="menu_top">
        <a href="./">¿Qué es?</a>
        <a class="activo" href="./historia">Historia</a>
        <a href="#">Misión y Visión</a>
        <a href="#">Familia Salesina</a>
        <a href="#">Perfil de atendidos</a>
    </div>

    <div class="historia">
        <Menuhistoria />
    </div>

    <style>
        .historia {
            padding-top: 0.7cqw;
            grid-column: 11/43;
            grid-row: 5/25;
            z-index: 2;
        }

        .que_es p {
            font-family: "Open Sans", sans-serif;
            font-size: 1.143cqw;
            font-weight: 500;
            letter-spacing: -0.009em;
            line-height: 1.571cqw;
            margin: 0;
        }

        .bg_quees {
            grid-column: 12/44;
            grid-row: 6/23;
            z-index: 1;
        }
        .menu_top {
            grid-column: 13/42;
            grid-row: 3/6;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .menu_top a {
            font-size: 1.143cqw;
            font-weight: 500;
            font-family: "Open Sans", sans-serif;
            color: #333333;
            text-decoration: none;
            transition: transform 0.25s ease;
        }

        .menu_top a:hover {
            transform: scale(1.08);
        }

        .menu_top .activo {
            font-weight: 700;
            background-color: #ff3545;
            color: #ffffff;
            border-radius: 1.4cqw;
            padding: 0.5cqw 1.1cqw;
        }
    </style>
</Rojo>
