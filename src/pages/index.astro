---
import Home from "../layouts/Home.astro";
---

<Home>
    <div class="que_es">
        <img class="t_home" src="/t_home.svg" alt="¿Qué es?" />
        <button class="btn_img_home" type="button" aria-label="Ver créditos">
            <img
                class="img_home"
                src="/img_home.png"
                alt="Comunidad de la Red de Casas Don Bosco"
            />
        </button>
    </div>

    <div class="velo" aria-hidden="true"></div>

    <div class="creditos">
        <img src="/creditos.png" alt="Créditos del proyecto de grado 2026" />
    </div>

    <style>
        /* El padre toma sus medidas SOLO de la cuadricula del stage:
           40 columnas (1000 px) x 19 filas (475 px) */
        .que_es {
            position: absolute;
            grid-column: 14/54;
            grid-row: 5/24;
            z-index: 2;

            display: grid;
            grid-template-columns: 1fr;
            grid-template-rows: 3fr 16fr; /* 19 filas internas = 3 titulo + 16 foto */
            justify-items: center;
            align-items: center;
        }

        /* ALTURA DEL TITULO: la define su fila (3fr de 19 = 3/19 de 475 px ~ 75 px) */
        .t_home {
            position: relative;
            grid-row: 1;
            height: 48%;
            width: auto;
            display: block;
            bottom: 2.25cqw;
        }

        .btn_img_home {
            position: relative;
            bottom: 13cqw;
            right: 1cqw;
            grid-row: 2;
            height: 100%;
            padding: 0;
            border: 0;
            background: none;
            cursor: pointer;
            display: grid;
            place-items: center;
            transition:
                transform 0.25s ease,
                filter 0.25s ease;
        }

        /* HOVER SUTIL: intensidad del efecto */
        .btn_img_home:hover {
            transform: scale(1.02);
            filter: brightness(1.04);
        }

        .btn_img_home:focus-visible {
            outline: 0.2cqw solid #ff3545;
            outline-offset: 0.4cqw;
        }

        .img_home {
            width: 100%;
            height: 100%;
            object-fit: contain;
            display: block;
        }

        /* Velo: TODA la pantalla visible (fuera de la cuadricula del stage) */
        .velo {
            position: fixed;
            top: 50%;
            left: 50%;
            width: 100vw;
            height: 100vh;
            height: 100dvh; /* movil: altura visible real (barra del navegador) */
            transform: translate(-50%, -50%);
            z-index: 4;
            background: rgba(0, 0, 0, 0.5);
            opacity: 0;
            pointer-events: none; /* cerrado: no estorba */
            transition: opacity 0.3s ease;
            cursor: pointer; /* invita a cerrar */
        }

        /* Creditos: encima del velo */
        .creditos {
            grid-column: 12/47;
            grid-row: 5/23;
            z-index: 5;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s ease;
        }

        .creditos img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            display: block;
        }

        /* Estado abierto */
        .velo.abierto,
        .creditos.abierto {
            opacity: 1;
            pointer-events: auto;
        }
    </style>

    <script>
        const btn = document.querySelector(".btn_img_home");
        const velo = document.querySelector(".velo");
        const creditos = document.querySelector(".creditos");

        const abrir = () => {
            velo?.classList.add("abierto");
            creditos?.classList.add("abierto");
        };
        const cerrar = () => {
            velo?.classList.remove("abierto");
            creditos?.classList.remove("abierto");
        };

        // Entrar en home siempre arranca con los creditos ocultos,
        // incluso al volver con Atras/Adelante (bfcache).
        cerrar();
        window.addEventListener("pageshow", cerrar);

        btn?.addEventListener("click", abrir);
        velo?.addEventListener("click", cerrar);
        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape") cerrar();
        });
    </script>
</Home>
