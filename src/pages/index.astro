---
import Home from "../layouts/Home.astro";
---

<Home>
    <div class="que_es">
        <img class="t_home" src="/t_home.svg" alt="¿Qué es?" />
        <div class="figura_home">
            <img
                class="img_home"
                src="/img_home.png"
                alt="Comunidad de la Red de Casas Don Bosco"
            />
        </div>
    </div>

    <style>
        /* El padre toma sus medidas SOLO de la cuadricula del stage:
           40 columnas (1000 px) x 19 filas (475 px) */
        .que_es {
            position: absolute;
            grid-column: 14/54;
            grid-row: 5/24;
            z-index: 2;

            display: grid;
            grid-template-columns: 1fr;
            grid-template-rows: 3fr 16fr; /* 19 filas internas = 3 titulo + 16 foto */
            justify-items: center;
            align-items: center;
        }

        /* ALTURA DEL TITULO: la define su fila (3fr de 19 = 3/19 de 475 px ~ 75 px) */
        .t_home {
            position: relative;
            grid-row: 1;
            height: 48%;
            width: auto;
            display: block;
            bottom: 2.25cqw;
        }

        .figura_home {
            position: relative;
            bottom: 13cqw;
            right: 1cqw;
            grid-row: 2;
            height: 100%;
            display: grid;
            place-items: center;
        }

        .img_home {
            width: 100%;
            height: 100%;
            object-fit: contain;
            display: block;
        }
    </style>
</Home>
