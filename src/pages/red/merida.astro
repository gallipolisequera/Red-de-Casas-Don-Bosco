---
import Naranja from "../../layouts/Naranja.astro";
import Menured from "../../components/Menured.astro";
---

<Naranja>
    <div class="menu_top">
        <a href="/red/caracas/sarria">Caracas</a>
        <a href="/red/valencia">Valencia</a>
        <a class="activo" href="/red/merida">Mérida</a>
        <a href="/red/puertolacruz">Puerto la Cruz</a>
        <a href="/red/sanfelix">San Félix</a>
        <a href="/red/sancristobal">San Cristóbal</a>
    </div>

    <div class="info">
        <div class="ubicacion">
            <p class="subtitulo">Ubicación</p>
            <p class="descripcion">
                Av. Los Próceres, Sector El Rincón Parte Baja, Nº0-13. 200
                metros de la entrada.
            </p>
            <a href=""><img src="/naranja/btn_explorar.svg" alt="" /></a>
        </div>

        <div class="caracteristicas">
            <div class="caracteristicas-scroll">
                <img src="/naranja/merida/merida_carac.svg" alt="" />
            </div>
            <div class="caracteristicas-barra" aria-hidden="true">
                <div class="caracteristicas-pista"></div>
                <div class="caracteristicas-thumb"></div>
            </div>
        </div>

        <div class="marco">
            <p class="subtitulo">
                Consejo Municipal de Derechos de Niños, Niñas y Adolescentes
            </p>
            <p lang="es" class="descripcion">
                Ejecuta sus servicios bajo la modalidad de Programa de Apoyo y
                Orientación para la <br />Integración Familiar y Social de niños
                y adolescentes en situaciones de riesgo <br /> y vulnerabilidad según
                lo establecido en el Artículo 124, literal b) de la LOPNNA, <br
                />implementando rutas técnicas para el fortalecimiento de los
                núcleos familiares <br /> monoparentales o en extrema vulnerabilidad
                y garantizando el ejercicio pleno de <br />sus derechos.
            </p>
        </div>

        <div class="contacto">
            <img src="/naranja/merida/merida_contac.svg" alt="" />
        </div>
    </div>

    <Menured />

    <div class="bg_valencia">
        <img src="/naranja/merida/bg_merida.svg" alt="" />
    </div>

    <style>
        .contacto {
            height: 100%;
            width: 100%;
            img {
                height: 12.5cqw;
            }
        }
        .marco {
            hyphens: auto;
        }
        .caracteristicas {
            position: relative;
            right: 1.8cqw;
            width: 105%;
            height: 100%;
            overflow: visible;
        }
        .caracteristicas-scroll {
            width: 100%;
            height: 100%;
            overflow-x: hidden;
            overflow-y: scroll;
            scrollbar-width: none;
            img {
                width: 48.3cqw;
                display: block;
            }
        }
        .caracteristicas-scroll::-webkit-scrollbar {
            display: none;
        }
        .caracteristicas-barra {
            position: absolute;
            top: 0;
            right: -0.95cqw;
            height: 100%;
            width: 1cqw;
            touch-action: none;
            user-select: none;
            cursor: pointer;
        }
        .caracteristicas-pista {
            position: absolute;
            top: 0;
            bottom: 0;
            left: calc(50% - 0.225cqw);
            width: 0.45cqw;
            border-radius: 999px;
            background: #ffbf80;
        }
        .caracteristicas-thumb {
            position: absolute;
            top: 0;
            left: calc(50% - 0.25cqw);
            width: 0.5cqw;
            height: 4cqw;
            border-radius: 999px;
            background: #ff8901;
            will-change: transform;
        }
        .ubicacion {
            position: absolute;
            display: flex;
            flex-direction: column;
            img {
                position: relative;
                top: 1.5cqw;
                right: 0.3cqw;
                width: 10cqw;
            }
        }
        .ubicacion a img {
            transition: transform 0.25s ease;
        }
        .ubicacion a:hover img {
            transform: scale(1.05);
        }
        .subtitulo {
            position: relative;
            bottom: 0.3cqw;
            margin: 0;
            color: #ff8901;
            font-size: 1.214cqw;
            font-weight: 700;
        }
        .descripcion {
            margin-top: 0.3cqw !important;
            font-family: "Open Sans", sans-serif;
            font-size: 1.143cqw;
            font-weight: 500;
            letter-spacing: -0.009em;
            line-height: 1.571cqw;
            margin: 0;
        }
        .submenu {
            grid-column: 33/40;
            grid-row: 6/9;
            z-index: 2;
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            align-items: center;
            a {
                cursor: pointer;
            }
            img {
                padding-left: 0.9cqw;
                width: 5cqw;
            }
        }
        .submenu a img {
            transition: transform 0.25s ease;
        }
        .submenu a:hover img {
            transform: scale(1.05);
        }
        .info {
            grid-column: 15/41;
            grid-row: 10/19;
            z-index: 2;
        }

        .bg_valencia {
            position: relative;
            top: 0.05cqw;
            margin-left: 0.5cqw;
            margin-top: 1.26cqw;
            grid-column: 12/44;
            grid-row: 5/22;
            z-index: 1;
            img {
                height: 99.4%; /* dimensiona el SVG */
            }
        }
        .menu_top {
            grid-column: 13/42;
            grid-row: 3/6;
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            align-items: center;
        }

        .menu_top a {
            font-size: 1.143cqw;
            font-weight: 500;
            font-family: "Open Sans", sans-serif;
            color: #333333;
            text-decoration: none;
            transition: transform 0.25s ease;
            padding: 0.5cqw 1.1cqw;
            justify-self: center;
            text-align: center;
            white-space: nowrap;
        }

        .menu_top a:hover {
            transform: scale(1.08);
        }

        .menu_top .activo {
            font-weight: 700;
            background-color: #ff8901;
            color: #ffffff;
            border-radius: 1.4cqw;
            padding: 0.5cqw 1.1cqw;
        }
    </style>

    <script>
        const caracteristicas = document.querySelector(".caracteristicas");
        const scroller = caracteristicas.querySelector(
            ".caracteristicas-scroll",
        );
        const barra = caracteristicas.querySelector(".caracteristicas-barra");
        const thumb = caracteristicas.querySelector(".caracteristicas-thumb");

        function maxTop() {
            return scroller.clientHeight - thumb.offsetHeight;
        }

        function actualizar() {
            if (caracteristicas.hidden) return;
            const max = maxTop();
            if (max <= 0 || scroller.scrollHeight <= scroller.clientHeight) {
                barra.style.display = "none";
                return;
            }
            barra.style.display = "";
            const rango = scroller.scrollHeight - scroller.clientHeight;
            const proporcion = scroller.scrollTop / rango;
            thumb.style.transform = `translateY(${proporcion * max}px)`;
        }

        function scrollDesdeY(y) {
            const max = maxTop();
            if (max <= 0) return;
            const proporcion = Math.min(
                1,
                Math.max(0, (y - thumb.offsetHeight / 2) / max),
            );
            scroller.scrollTop =
                proporcion * (scroller.scrollHeight - scroller.clientHeight);
        }

        let arrastrando = false;

        barra.addEventListener("pointerdown", (evento) => {
            if (caracteristicas.hidden) return;
            arrastrando = true;
            barra.setPointerCapture(evento.pointerId);
            scrollDesdeY(evento.clientY - barra.getBoundingClientRect().top);
        });

        barra.addEventListener("pointermove", (evento) => {
            if (!arrastrando) return;
            scrollDesdeY(evento.clientY - barra.getBoundingClientRect().top);
        });

        barra.addEventListener("pointerup", () => {
            arrastrando = false;
        });

        barra.addEventListener("pointercancel", () => {
            arrastrando = false;
        });

        barra.addEventListener(
            "wheel",
            (evento) => {
                scroller.scrollTop += evento.deltaY;
                evento.preventDefault();
            },
            { passive: false },
        );

        scroller.addEventListener("scroll", actualizar, { passive: true });

        const imagen = scroller.querySelector("img");
        if (imagen) {
            if (imagen.complete) actualizar();
            else imagen.addEventListener("load", actualizar);
        }

        const ro = new ResizeObserver(() => actualizar());
        ro.observe(caracteristicas);

        const mo = new MutationObserver(() => {
            requestAnimationFrame(actualizar);
        });
        mo.observe(caracteristicas, {
            attributes: true,
            attributeFilter: ["hidden"],
        });

        actualizar();
    </script>
</Naranja>
