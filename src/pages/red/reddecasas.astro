---
import Rojo from "../../layouts/Rojo.astro";
---

<Rojo>
    <div class="menu_top">
        <a class="activo" href="#">¿Qué es?</a>
        <a href="/casas/historia">Historia</a>
        <a href="/casas/misionyvision">Misión y Visión</a>
        <a href="/casas/familia">Familia Salesina</a>
        <a href="/casas/perfil">Perfil de atendidos</a>
    </div>

    <div class="que_es">
        <p>
            Es una Asociación Civil, sin fines de lucro, que brinda apoyo y
            acompañamiento a <br />niños, niñas, adolescentes, jóvenes (NNAJ) y
            sus familias que sufren severas situaciones de abandono económico,
            social y moral, mediante la creación de obras y servicios, y la
            realizacióde actividades educativas, deportivas, asistenciales,
            culturales, tecnológicas, artísticas y religiosas, así como también
            estimular a este fin a otras personas naturales o jurídicas, u
            organizaciones.
        </p>
    </div>
    <div class="bg_quees">
        <img src="/rojo/que_es/bg_quees.svg" alt="" />
    </div>

    <style>
        .que_es {
            grid-column: 15/41;
            grid-row: 10/16;
            z-index: 2;
        }

        .que_es p {
            font-family: "Open Sans", sans-serif;
            font-size: 1.143cqw;
            font-weight: 500;
            letter-spacing: -0.009em;
            line-height: 1.571cqw;
            margin: 0;
        }

        .bg_quees {
            grid-column: 12/44;
            grid-row: 6/23;
            z-index: 1;
        }
        .menu_top {
            grid-column: 13/42;
            grid-row: 3/6;
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            align-items: center;
        }

        .menu_top a {
            font-size: 1.143cqw;
            font-weight: 500;
            font-family: "Open Sans", sans-serif;
            color: #333333;
            text-decoration: none;
            transition: transform 0.25s ease;
            padding: 0.5cqw 1.1cqw;
            justify-self: center;
            text-align: center;
            white-space: nowrap;
        }

        .menu_top a:hover {
            transform: scale(1.08);
        }

        .menu_top .activo {
            font-weight: 700;
            background-color: #ff3545;
            color: #ffffff;
            border-radius: 1.4cqw;
            padding: 0.5cqw 1.1cqw;
        }
    </style>
</Rojo>
