---
import Naranja from "../../layouts/Naranja.astro";
---

<Naranja>
    <div class="que_es">
        <p>
            La Red de Casas Don Bosco se extiende a lo largo del país para
            brindar protección, educación y esperanza a la infancia y juventud
            más vulnerable. Cada una de nuestras sedes responde con amor y
            dedicación a los desafíos de su entorno local. Explora nuestro mapa
            nacional, conoce las características que distinguen a cada casa<br
            />
            y encuentra los puntos de contacto para sumarte a nuestra labor.
        </p>
    </div>

    <div class="ver_casas">
        <a href="/red/caracas/sarria"
            ><img
                src="/naranja/btn_vercasas.svg"
                alt=""
                class="ver"
            /></a
        >
    </div>

    <div class="bg_red">
        <img src="/naranja/bg_red.svg" alt="" />
    </div>

    <style>
        .ver_casas {
            grid-column: 36/43;
            grid-row: 21/24;
            z-index: 2;
            padding-top: 1.3cqw;
            padding-left: 1.3cqw;
            padding-right: 1cqw;
        }
        .ver_casas a img.ver {
            transition: transform 0.25s ease;
        }
        .ver_casas a:hover img.ver {
            transform: scale(1.05);
        }
        .que_es {
            grid-column: 15/41;
            grid-row: 10/16;
            z-index: 2;
        }

        .que_es p {
            font-family: "Open Sans", sans-serif;
            font-size: 1.143cqw;
            font-weight: 500;
            letter-spacing: -0.009em;
            line-height: 1.571cqw;
            margin: 0;
        }

        .bg_red {
            margin-left: 0.4cqw;
            margin-top: 0.5cqw;
            grid-column: 12/44;
            grid-row: 6/22;
            z-index: 1;
            img {
                height: 100%; /* dimensiona el SVG */
            }
        }
        .menu_top {
            grid-column: 13/42;
            grid-row: 3/6;
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            align-items: center;
        }

        .menu_top a {
            font-size: 1.143cqw;
            font-weight: 500;
            font-family: "Open Sans", sans-serif;
            color: #333333;
            text-decoration: none;
            transition: transform 0.25s ease;
            padding: 0.5cqw 1.1cqw;
            justify-self: center;
            text-align: center;
            white-space: nowrap;
        }

        .menu_top a:hover {
            transform: scale(1.08);
        }

        .menu_top .activo {
            font-weight: 700;
            background-color: #ff3545;
            color: #ffffff;
            border-radius: 1.4cqw;
            padding: 0.5cqw 1.1cqw;
        }
    </style>
</Naranja>
