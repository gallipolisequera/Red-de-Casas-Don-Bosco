<style>
	.menu_perfil svg {
		display: block;
		width: 100%;
		height: auto;
	}

	.menu_perfil [data-activo] {
		display: none;
		pointer-events: none;
	}

	.menu_perfil[data-visible="1"] [data-activo="1"],
	.menu_perfil[data-visible="2"] [data-activo="2"],
	.menu_perfil[data-visible="3"] [data-activo="3"],
	.menu_perfil[data-visible="4"] [data-activo="4"],
	.menu_perfil[data-visible="5"] [data-activo="5"],
	.menu_perfil[data-visible="6"] [data-activo="6"] {
		display: block;
	}

	.menu_perfil[data-visible="1"] [data-btn="1"],
	.menu_perfil[data-visible="2"] [data-btn="2"],
	.menu_perfil[data-visible="3"] [data-btn="3"],
	.menu_perfil[data-visible="4"] [data-btn="4"],
	.menu_perfil[data-visible="5"] [data-btn="5"],
	.menu_perfil[data-visible="6"] [data-btn="6"] {
		display: none;
	}

	.menu_perfil [data-btn] {
		transition: transform 0.25s ease;
	}

	.menu_perfil [data-btn]:hover {
		transform: scale(1.12);
	}
</style>

<script>
	const menu = document.querySelector(".menu_perfil");
	menu.querySelectorAll("[data-btn]").forEach((boton) => {
		boton.addEventListener("click", () => {
			menu.dataset.visible = boton.dataset.btn;
		});
	});
</script>
