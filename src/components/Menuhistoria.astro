<style>
	.menu_historia svg {
		display: block;
		width: 100%;
		height: auto;
	}

	.menu_historia [data-activo] {
		display: none;
		pointer-events: none;
	}

	.menu_historia[data-visible="1"] [data-activo="1"],
	.menu_historia[data-visible="2"] [data-activo="2"],
	.menu_historia[data-visible="3"] [data-activo="3"],
	.menu_historia[data-visible="4"] [data-activo="4"],
