</style>

<script>
	const menu = document.querySelector(".menu_historia");
	menu.querySelectorAll("[data-btn]").forEach((boton) => {
		boton.addEventListener("click", () => {
			menu.dataset.visible = boton.dataset.btn;
		});
	});
</script>
