---
import TestimoniosNav from "../components/TestimoniosNav.astro";

interface Props {
	title?: string;
	testimonioActivo?: 0 | 1 | 2 | 3 | 4;
}

const { title = "Casas Don Bosco - Testimonios", testimonioActivo = 0 } =
	Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<div class="stage">
			<div id="logo">
				<img src="/logo.svg" alt="" />
			</div>

			<div id="curvaroja">
				<img src="/amarillo/curvaamarillo.svg" alt="" />
			</div>

			<div id="menu_iz">
				<a class="menu3" href="/testimonios/testimonios"
					><img src="/menuiz/menu3r.svg" alt="" /></a
				>
				<a class="menu4" href="#"
					><img src="/menuiz/menu4r.svg" alt="" /></a
				>
				<a class="menu5" href="#"
					><img src="/menuiz/menu5r.svg" alt="" /></a
				>
				<a class="menu6" href="#"
					><img src="/menuiz/menu6r.svg" alt="" /></a
				>
				<a class="menu1" href="/"
					><img src="/menuiz/menu1r.svg" alt="" /></a
				>
				<a class="menu2" href="/red/reddecasas"
					><img src="/menuiz/menu2r.svg" alt="" /></a
				>
			</div>

			<div class="navegadores">
				<img class="flearriba" src="/amarillo/fleamarilla.svg" alt="" />
				<img class="fleabajo" src="/amarillo/fleamarilla.svg" alt="" />
			</div>

			<TestimoniosNav activo={testimonioActivo} />

			<div class="bgcarrusel">
				<img
					class="amarillo_bgcarru"
					src="/amarillo/amarillo_bgcarru.svg"
					alt=""
				/>
			</div>

			<div class="blanco_bg">
				<img src="/bg/blanco_bg.svg" alt="" />
			</div>

			<div class="footer">
				<div class="rrss">
					<a href="https://www.instagram.com/reddecasasdonboscovzla" target="_blank" rel="noopener"
						><img src="/footer/ig.svg" alt="Instagram" /></a
					>
					<a href="#" target="_blank" rel="noopener"
						><img src="/footer/ws.svg" alt="WhatsApp" /></a
					>
					<a href="https://www.facebook.com/share/1Bp1ZVLxgM/" target="_blank" rel="noopener"
						><img src="/footer/fb.svg" alt="Facebook" /></a
					>
				</div>
				<img src="/footer/footerbg.svg" alt="" />
			</div>

			<slot />
		</div>
	</body>
</html>

<script>
	const nav = document.querySelector(".testimonios-nav");
	if (nav) {
		const activo = parseInt(nav.dataset.activo || "0", 10);
		const flearriba = document.querySelector(".flearriba");
		const fleabajo = document.querySelector(".fleabajo");

		const urls = [
			"/testimonios/testimonios",
			"/testimonios/testimonio1",
			"/testimonios/testimonio2",
			"/testimonios/testimonio3",
			"/testimonios/testimonio4",
		];

		flearriba?.addEventListener("click", () => {
			const prev = activo === 0 ? urls.length - 1 : activo - 1;
			window.location.href = urls[prev];
		});

		fleabajo?.addEventListener("click", () => {
			const next = activo === urls.length - 1 ? 0 : activo + 1;
			window.location.href = urls[next];
		});
	}
</script>

<style is:global>
	@font-face {
		font-family: "Open Sans";
		src: url("/fonts/OpenSans-Regular.woff2") format("woff2");
		font-weight: 400;
		font-style: normal;
		font-display: swap;
	}

	@font-face {
		font-family: "Open Sans";
		src: url("/fonts/OpenSans-Medium.woff2") format("woff2");
		font-weight: 500;
		font-style: normal;
		font-display: swap;
	}

	@font-face {
		font-family: "Open Sans";
		src: url("/fonts/OpenSans-SemiBold.woff2") format("woff2");
		font-weight: 600;
		font-style: normal;
		font-display: swap;
	}

	@font-face {
		font-family: "Open Sans";
		src: url("/fonts/OpenSans-Bold.woff2") format("woff2");
		font-weight: 700;
		font-style: normal;
		font-display: swap;
	}

	@font-face {
		font-family: "Open Sans";
		src: url("/fonts/OpenSans-ExtraBold.woff2") format("woff2");
		font-weight: 800;
		font-style: normal;
		font-display: swap;
	}

	html,
	body {
		margin: 0;
		height: 100%;
		overflow: hidden;
	}

	body {
		display: grid;
		place-items: center;
		background: #fffff;
	}

	.footer {
		display: flex;
		align-items: center;
		padding-top: 0.1cqw;
		padding-left: 0.65cqw;
		padding-right: 0.5cqw;
		position: relative;
		z-index: 3;
		grid-column: 3/44;
		grid-row: 24/26;
		img {
			width: 100%;
			display: block;
		}
	}

	.rrss {
		position: absolute;
		right: 1.7cqw;
		top: 50%;
		transform: translateY(-50%);
		z-index: 1;
		display: flex;
		gap: 1.8cqw;
		a {
			display: inline-flex;
			cursor: pointer;
			transition: transform 0.25s ease;
		}
		a:hover {
			transform: scale(1.15);
		}
		img {
			height: 1.8cqw;
		}
	}

	.bgcarrusel {
		grid-column: 46/57;
		grid-row: 3/25;
		z-index: 1;
	}

	.amarillo_bgcarru {
		position: relative;
		width: 17.5cqw;
	}

	.navegadores {
		display: flex;
		flex-direction: column;
		justify-content: space-between;

		z-index: 3;
		grid-column: 50/52;
		grid-row: 2/26;
		img {
			width: 100%;
		}
	}

	.testimonios-nav {
		z-index: 2;
		grid-column: 46/57;
		grid-row: 4/25;
		padding: 0.5cqw 0;
	}

	.flearriba,
	.fleabajo {
		cursor: pointer;
		transition: transform 0.25s ease;
	}

	.fleabajo {
		transform: rotate(180deg);
	}

	.flearriba:hover {
		transform: scale(1.15);
	}

	.fleabajo:hover {
		transform: rotate(180deg) scale(1.15);
	}

	#logo {
		grid-column: 3/9;
		grid-row: 2/4;
		z-index: 1;
	}

	#curvaroja {
		display: flex;
		align-items: flex-start;
		grid-column: 2/11;
		grid-row: 8/24;
		z-index: 1;
		img {
			height: 100.3%;
		}
	}

	#menu_iz {
		display: flex;
		flex-direction: column;
		grid-column: 3/10;
		grid-row: 6/23;
		z-index: 1;
		justify-content: flex-start;
	}
	.menu1 {
		position: relative;
		margin-bottom: 2.15cqw;
		top: 0.45cqw;
		left: 0.7cqw;
		img {
			width: 9cqw;
		}
	}

	.menu2 {
		position: relative;
		margin-bottom: 2.4cqw;
		top: 0.7cqw;
		left: 4.3cqw;

		img {
			width: 7.4cqw;
		}
	}

	.menu3 {
		position: relative;
		margin-bottom: 2.94cqw;
		top: 0.5cqw;
		left: 0.7cqw;

		img {
			width: 9.8cqw;
		}
	}

	.menu4 {
		position: relative;
		margin-bottom: 1.94cqw;
		top: cqw;
		left: 2.25cqw;

		img {
			width: 9.5cqw;
		}
	}

	.menu5 {
		position: relative;
		margin-bottom: 2.24cqw;
		top: 0.425cqw;
		left: 0.7cqw;

		img {
			width: 10.7cqw;
		}
	}

	.menu6 {
		position: relative;
		margin-bottom: 2.46cqw;
		top: 0.577cqw;
		left: 1.9cqw;

		img {
			width: 9.9cqw;
		}
	}

	.menu1,
	.menu2,
	.menu3,
	.menu4,
	.menu5,
	.menu6 {
		cursor: pointer;
	}

	.menu1 img,
	.menu2 img,
	.menu3 img,
	.menu4 img,
	.menu5 img,
	.menu6 img {
		transition: transform 0.25s ease;
	}

	.menu1:hover img,
	.menu2:hover img,
	.menu3:hover img,
	.menu4:hover img,
	.menu5:hover img,
	.menu6:hover img {
		transform: scale(1.08);
	}

	.blanco_bg {
		grid-column: 1/57;
		grid-row: 1/27;
	}

	.stage {
		width: min(100vw, calc(100vh * 1400 / 650));
		aspect-ratio: 1400 / 650;
		position: relative;
		display: grid;
		grid-template-columns: repeat(56, 1fr);
		grid-template-rows: repeat(26, 1fr);
		container-type: size;
		font-size: 1cqw;
		font-family: "Open Sans", sans-serif;
		background: #e8b618;
	}
</style>
